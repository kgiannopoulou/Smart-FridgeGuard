# Copy to .env and fill in. .env is git-ignored (NFR-6). Never commit real secrets.

# SQLite database location
FRIDGEGUARD_DB=data/fridgeguard.db

# Dashboard analyst login: store a password HASH, never the plain password
FRIDGEGUARD_ANALYST_USER=analyst
FRIDGEGUARD_ANALYST_PASSWORD_HASH=

# Optional ThingsBoard Edge adapter (later phase): one access token per device
THINGSBOARD_HOST=localhost
THINGSBOARD_MQTT_PORT=1883
TB_TOKEN_FRIDGE_001=
TB_TOKEN_FRIDGE_002=
TB_TOKEN_FRIDGE_003=

# Notifications (Step 13). Non-secret settings are in config/notifications.yaml;
# these override them. Leave empty to use the YAML values.
FRIDGEGUARD_EMAIL_MODE=            # file (default: .eml files in reports/outbox) or smtp
FRIDGEGUARD_EMAIL_OUTBOX=
FRIDGEGUARD_SMTP_HOST=             # e.g. localhost for Mailpit, smtp.example.com for a provider
FRIDGEGUARD_SMTP_PORT=             # 1025 Mailpit, 587 with starttls: true
FRIDGEGUARD_SMTP_USER=
FRIDGEGUARD_SMTP_PASSWORD=
FRIDGEGUARD_SMTP_FROM=
FRIDGEGUARD_SMTP_TO=               # comma-separated
# Telegram (optional; also set telegram.enabled: true in config/notifications.yaml)
FRIDGEGUARD_TELEGRAM_TOKEN=        # from @BotFather
FRIDGEGUARD_TELEGRAM_CHAT_ID=
