# Copy to .env and fill in. .env is git-ignored (NFR-6). Never commit real secrets.

# SQLite database location
FRIDGEGUARD_DB=data/fridgeguard.db

# Dashboard analyst login: store a password HASH, never the plain password
FRIDGEGUARD_ANALYST_USER=analyst
FRIDGEGUARD_ANALYST_PASSWORD_HASH=

# Optional ThingsBoard Edge adapter (later phase): one access token per device
THINGSBOARD_HOST=localhost
THINGSBOARD_MQTT_PORT=1883
TB_TOKEN_FRIDGE_001=
TB_TOKEN_FRIDGE_002=
TB_TOKEN_FRIDGE_003=
